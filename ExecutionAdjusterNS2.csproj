<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputPath>bin\ExecutionAdjuster\bin\Win64_Shipping_Client\</OutputPath>
    <SignAssembly>False</SignAssembly>
    <PlatformTarget>x64</PlatformTarget>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.MCM" Version="5.10.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="dependencies\*.dll" Exclude="dependencies\TaleWorlds.Native.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="SubModule.xml" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="CopySubModuleXml" AfterTargets="Build">
    <Copy SourceFiles="SubModule.xml" DestinationFolder="bin\ExecutionAdjuster\" />
  </Target>

</Project>
